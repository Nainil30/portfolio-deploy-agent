# Copy to .env and fill in. .env is gitignored.

# ── Telegram (required for the bot) ─────────────────────────────
# 1. In Telegram, message @BotFather → /newbot → copy the token here.
TELEGRAM_BOT_TOKEN=
# 2. Start the bot, send /start, and it replies with your chat id. Paste it here.
#    Only this chat can use the bot.
TELEGRAM_CHAT_ID=

# ── Optional AI assistant (free) ────────────────────────────────
# Without a key the bot still understands "bought 400 of nvda", "5k bonus", etc.
# groq (free key: https://console.groq.com) | gemini (https://aistudio.google.com) | ollama (local) | none
LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b   # auto-switches if the provider retires a model
# LLM_BASE_URL=           # any OpenAI-compatible endpoint

# ── Paths (optional) ────────────────────────────────────────────
# PDA_DB=data/pda.db
# PDA_STRATEGY=config/strategy.yaml
